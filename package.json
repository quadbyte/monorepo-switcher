{
  "name": "monorepo-switcher",
  "version": "1.0.0",
  "description": "Intelligent CLI for fast monorepo workspace switching",
  "main": "build/cli.js",
  "bin": {
    "monorepo-switcher": "build/cli.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=build/cli.js",
    "dev": "npm run build -- --watch",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "clean": "rm -rf build",
    "prepublishOnly": "npm run clean && npm run lint && npm run build && npm test"
  },
  "keywords": [
    "monorepo",
    "cli",
    "developer-tools",
    "typescript",
    "nodejs",
    "productivity",
    "workflow",
    "vscode",
    "switching"
  ],
  "author": "Quadbyte <oss@quadbyte.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quadbyte/monorepo-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/quadbyte/monorepo-switcher/issues"
  },
  "homepage": "https://github.com/quadbyte/monorepo-switcher#readme",
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "ora": "^7.0.1",
    "fast-glob": "^3.3.2",
    "simple-git": "^3.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "esbuild": "^0.19.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build",
    "README.md"
  ]
}